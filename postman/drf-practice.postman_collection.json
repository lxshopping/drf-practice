      "item": [
        {
          "name": "01 合法生产发布单：规范化 app_code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"release_no\": \"RO-D01-{{$guid}}\",\n  \"app_code\": \" DMS-MDM \",\n  \"app_name\": \"主数据服务\",\n  \"env_name\": \"prod\",\n  \"branch_name\": \"release/v1\",\n  \"jenkins_job_name\": \"dms-mdm-pipeline\",\n  \"status\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/release-orders/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "release-orders",
                ""
              ]
            },
            "description": "预期 201；响应 app_code 为 dms-mdm；status 为 CREATED。"
          },
          "response": []
        },
